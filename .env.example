DATABASE_URL=postgresql://agents:replace-me@localhost:5432/agents
LITELLM_URL=http://localhost:4000/v1
LITELLM_API_KEY=replace-with-a-scoped-virtual-key
AGENT_API_KEY=replace-with-a-random-bearer-token
SEARXNG_URL=http://localhost:8080
DATA_DIR=./artifacts
SKILLS_DIR=./agents/news/skills
PUBLIC_URL=http://localhost:8000/agents/news
A2A_URL=http://localhost:8000/a2a
# Set true only behind an ingress that overwrites this header with verified SSO identity.
TRUST_SSO=false

EMBEDDING_MODEL=bge-m3
# Optional Langfuse tracing (keep credentials outside Git)
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
